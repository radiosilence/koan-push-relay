{
  "name": "@radiosilence/koan-relay-pulumi",
  "version": "0.1.2",
  "description": "Pulumi component that deploys koan's push relay into Kubernetes",
  "license": "MIT",
  "author": "James Cleveland <jc@blit.cc>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radiosilence/koan-push-relay.git",
    "directory": "deploy/pulumi"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json && vitest run",
    "prepublishOnly": "aube run build"
  },
  "devDependencies": {
    "@pulumi/kubernetes": "4.34.2",
    "@pulumi/pulumi": "3.273.0",
    "typescript": "6.0.3",
    "vitest": "^5",
    "zod": "4.6.7"
  }
}
